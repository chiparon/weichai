RETRIEVAL_HOST=127.0.0.1
RETRIEVAL_PORT=8787
RETRIEVAL_CORS_ORIGIN=*
# Comma-separated exact repository IDs. Leave unset only for health/indexing
# work: search requests then fail closed instead of searching every indexed repo.
# Example for the bundled corpus: fixtures/code-corpus
RETRIEVAL_ALLOWED_REPOSITORIES=forexplore-reference-java,swift-cache-ts

SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=forexplore
SEEKDB_TABLE=code_symbols
SEEKDB_AUTO_MIGRATE=true
SEEKDB_VECTOR_DIMENSION=384

# "hash" works offline and is useful for smoke tests. "openai" provides
# production-quality semantic embeddings through any OpenAI-compatible API.
SEEKDB_EMBEDDING_PROVIDER=hash
SEEKDB_EMBEDDING_URL=https://api.openai.com/v1/embeddings
SEEKDB_EMBEDDING_API_KEY=
SEEKDB_EMBEDDING_MODEL=text-embedding-3-small
# Set to true when the model supports the "dimensions" parameter (e.g. OpenAI text-embedding-3-*, Qwen3).
# Leave false for models that always return their native dimension (e.g. BGE series).
SEEKDB_EMBEDDING_SUPPORTS_DIMENSIONS=true

# ── Stage-1 directory selection ─────────────────────────────────────────
# First match the query against corpus directory (repository) names, then run
# the fine-grained character-precise retrieval only inside the selected
# directories. Set to false to search the full authorized scope directly.
RETRIEVAL_DIRECTORY_SELECTION=true
# How many top-scoring directories to keep before fine-grained retrieval.
RETRIEVAL_DIRECTORY_TOP_M=3
# Best directory score below which the selector falls back to the full scope.
RETRIEVAL_DIRECTORY_MIN_SCORE=0.05

# ── LLM Reranking ───────────────────────────────────────────────────────
# "none" disables LLM reranking entirely (default).
# "deepseek" uses the same DeepSeek configuration as the Claude Code and
# translation workflows.
RERANK_PROVIDER=none

# Shared DeepSeek configuration — only read when RERANK_PROVIDER=deepseek.
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Retry and timeout tuning for the DeepSeek call and response-contract repair.
RERANK_TIMEOUT_MS=90000
RERANK_MAX_RETRIES=2
RERANK_VALIDATION_RETRIES=2
