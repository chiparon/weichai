{
  "dataset": "enterprise-asset-upgrade",
  "version": 1,
  "purpose": "Mixed enterprise code assets for technology-upgrade and new-module tasks.",
  "targetLanguage": "csharp",
  "repositories": [
    {
      "id": "apache-camel",
      "url": "https://github.com/apache/camel.git",
      "homepage": "https://github.com/apache/camel",
      "license": "Apache-2.0",
      "languages": ["java"],
      "role": ["integration", "routing", "protocol-adaptation"],
      "paths": ["core", "components/camel-file", "components/camel-http", "components/camel-jms", "components/camel-sql"]
    },
    {
      "id": "flowable-engine",
      "url": "https://github.com/flowable/flowable-engine.git",
      "homepage": "https://github.com/flowable/flowable-engine",
      "license": "Apache-2.0",
      "languages": ["java"],
      "role": ["workflow", "state-transition", "task-orchestration"],
      "paths": ["modules/flowable-engine", "modules/flowable-bpmn-model", "modules/flowable-bpmn-converter", "modules/flowable-common"]
    },
    {
      "id": "keycloak",
      "url": "https://github.com/keycloak/keycloak.git",
      "homepage": "https://github.com/keycloak/keycloak",
      "license": "Apache-2.0",
      "languages": ["java", "typescript"],
      "role": ["identity", "authorization", "tenant-boundary"],
      "paths": ["services", "model", "server-spi", "js"]
    },
    {
      "id": "bullmq",
      "url": "https://github.com/taskforcesh/bullmq.git",
      "homepage": "https://github.com/taskforcesh/bullmq",
      "license": "MIT",
      "languages": ["typescript"],
      "role": ["queue", "retry", "delayed-job", "idempotency"],
      "paths": ["src"]
    },
    {
      "id": "apscheduler",
      "url": "https://github.com/agronholm/apscheduler.git",
      "homepage": "https://github.com/agronholm/apscheduler",
      "license": "MIT",
      "languages": ["python"],
      "role": ["scheduling", "periodic-job", "failure-recovery"],
      "paths": ["src"]
    },
    {
      "id": "nopcommerce",
      "url": "https://github.com/nopSolutions/nopCommerce.git",
      "homepage": "https://github.com/nopSolutions/nopCommerce",
      "license": "MIT",
      "languages": ["csharp", "javascript"],
      "role": ["business-domain", "order", "plugin-architecture"],
      "paths": ["src/Libraries/Nop.Core", "src/Libraries/Nop.Services", "src/Libraries/Nop.Data", "src/Presentation/Nop.Web/Areas/Admin"]
    },
    {
      "id": "commons-fileupload",
      "url": "https://github.com/apache/commons-fileupload.git",
      "homepage": "https://github.com/apache/commons-fileupload",
      "license": "Apache-2.0",
      "languages": ["java"],
      "role": ["file-upload", "stream-processing", "input-validation"],
      "paths": ["commons-fileupload2-core/src/main/java", "commons-fileupload2-jakarta-servlet5/src/main/java", "commons-fileupload2-jakarta-servlet6/src/main/java", "commons-fileupload2-javax/src/main/java", "src/main/java"]
    }
  ]
}
